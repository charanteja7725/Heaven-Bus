PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=heaven_bus
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SEED_DEMO=true
VITE_API_URL=http://localhost:4000

# Journey-day email reminders (Resend)
RESEND_API_KEY=
JOURNEY_EMAIL_FROM=
PUBLIC_APP_URL=http://localhost:5173

# Primary outbound email (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=HEAVEN-BUS


# Local interview showcase only (store the real value in .env.showcase, never commit it)
SHOWCASE_MONGODB_URI=

# Apache JMeter performance tests target the local showcase API by default
JMETER_BASE_URL=http://127.0.0.1:4000


# Local Ask Jarvis AI (recommended: keep these in .env.ollama)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=20000
